PORT=5000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Database Configuration
# Dialect can be: sqlite, mysql, postgres
DB_DIALECT=postgres

# For Supabase/PostgreSQL
DB_HOST=your_supabase_host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your_supabase_password_here

# For SQLite local development (only used if DB_DIALECT=sqlite)
DB_STORAGE=

# SMTP Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tea-billing@university.edu
